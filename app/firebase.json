{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting": {
        "public": "build/web",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/app",
                "destination": "/app/index.html"
            },
            {
                "source": "/app/**",
                "destination": "/app/index.html"
            },
            {
                "source": "/m/app",
                "destination": "/app/index.html"
            },
            {
                "source": "/m/app/**",
                "destination": "/app/index.html"
            },
            {
                "source": "/admin",
                "destination": "/app/index.html"
            },
            {
                "source": "/admin/**",
                "destination": "/app/index.html"
            }
        ]
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "hosting": {
            "port": 5002
        },
        "ui": {
            "enabled": true,
            "port": 4000
        },
        "singleProjectMode": true
    }
}
