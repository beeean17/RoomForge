{
  "name": "@roomforge/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 9240",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 9241",
    "test:editor-candidates": "node --experimental-strip-types scripts/verify-editor-candidate-review.mjs",
    "test:editor-fixtures": "node --experimental-strip-types scripts/verify-editor-structural-fixtures.mjs",
    "test:editor-placed": "node --experimental-strip-types scripts/verify-editor-placed-objects.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
